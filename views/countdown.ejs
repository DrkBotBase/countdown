<!DOCTYPE html>
<html lang="es">
<head>
    <%- include('partials/head', {title: `SENTENCIA - ${user.name}`}); %>
</head>
<body class="bg-black text-gray-300 font-digital overflow-hidden selection:bg-blood h-full">
    <main class="relative z-50 flex flex-col items-center justify-between h-full w-full px-4 py-8">
        <div class="flex flex-col items-center justify-center flex-grow gap-2 md:gap-4 w-full max-w-[280px] md:max-w-sm mx-auto">
            <!-- Años -->
            <div class="flex flex-col items-center w-full">
                <span class="text-[7px] md:text-[9px] tracking-[0.5em] text-gray-300">YEARS</span>
                <div id="years" class="text-7xl md:text-8xl font-light tracking-tighter leading-none transition-all duration-300">00</div>
            </div>
            <!-- Días -->
            <div class="flex flex-col items-center w-full">
                <span class="text-[9px] md:text-[9px] tracking-[0.5em] text-gray-300">DAYS</span>
                <div id="days" class="text-7xl md:text-8xl font-light tracking-tighter leading-none transition-all duration-300">00</div>
            </div>
            <!-- Horas -->
            <div class="flex flex-col items-center w-full">
                <span class="text-[9px] md:text-[9px] tracking-[0.5em] text-gray-300">HOURS</span>
                <div id="hours" class="text-7xl md:text-8xl font-light tracking-tighter leading-none transition-all duration-300">00</div>
            </div>
            <!-- Minutos -->
            <div class="flex flex-col items-center w-full">
                <span class="text-[9px] md:text-[9px] tracking-[0.5em] text-gray-300">MINUTES</span>
                <div id="minutes" class="text-7xl md:text-8xl font-light tracking-tighter leading-none transition-all duration-300">00</div>
            </div>
            <!-- Segundos -->
            <div class="flex flex-col items-center w-full">
                <span class="text-[9px] md:text-[9px] tracking-[0.5em] text-gray-300">SECONDS</span>
                <div id="seconds" class="text-7xl md:text-8xl font-light tracking-tighter leading-none transition-all duration-300">00</div>
            </div>

        <div id="footerInfo" class="w-full text-center opacity-0 transition-opacity duration-1000 space-y-2 px-4 pb-2">
            <p class="text-[10px] md:text-[12px] uppercase tracking-[0.4em] text-gray-300"><%= user.name %></p>
            <div class="h-[1px] w-8 bg-blood mx-auto"></div>
            
            <div class="mt-4 max-w-xs mx-auto">
              <button class="w-full bg-blood/10 border border-blood/30 text-blood py-3 text-[9px] font-bold uppercase tracking-[0.4em] hover:bg-blood hover:text-white transition-all duration-700">
                <%= user.cause %>
              </button>
            </div>
        </div>
      </div>
    </main>

    <script>
        localStorage.setItem('countdown_user_id', '<%= user._id %>');

        function isStandalone() {
            return (window.matchMedia('(display-mode: standalone)').matches) || 
                   (window.navigator.standalone) || 
                   localStorage.getItem('pwa_bypass') === 'true';
        }

        if (!isStandalone()) {
             window.location.href = '/';
        }

        history.pushState(null, null, location.href);
        window.onpopstate = function () {
            history.go(1);
        };

        const deathDate = new Date('<%= user.deathDate %>');
        const ids = ['seconds', 'minutes', 'hours', 'days', 'years'];
        let isAnimating = true;

        function getTargetValues() {
            const now = new Date();
            const diff = deathDate - now;
            if (diff <= 0) return { years: 0, days: 0, hours: 0, minutes: 0, seconds: 0 };
            return {
                years: Math.floor(diff / (1000 * 60 * 60 * 24 * 365.25)),
                days: Math.floor((diff % (1000 * 60 * 60 * 24 * 365.25)) / (1000 * 60 * 60 * 24)),
                hours: Math.floor((diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)),
                minutes: Math.floor((diff % (1000 * 60 * 60)) / (1000 * 60)),
                seconds: Math.floor((diff % (1000 * 60)) / 1000)
            };
        }

        async function animateValue(id, target) {
            const el = document.getElementById(id);
            let current = 0;
            const duration = 800;
            const step = Math.max(1, Math.floor(target / 20));
            return new Promise(resolve => {
                const timer = setInterval(() => {
                    current += step;
                    if (current >= target) {
                        current = target;
                        clearInterval(timer);
                        el.textContent = current.toString().padStart(2, '0');
                        if (current === 0) el.classList.add('is-zero');
                        resolve();
                    }
                    el.textContent = current.toString().padStart(2, '0');
                }, 30);
            });
        }

        async function startSequence() {
            const targets = getTargetValues();
            for (const id of ids) {
                await animateValue(id, targets[id]);
                await new Promise(r => setTimeout(r, 100));
            }
            isAnimating = false;
            document.getElementById('footerInfo').classList.remove('opacity-0');
            startLiveCountdown();
        }

        function startLiveCountdown() {
            setInterval(() => {
                if (isAnimating) return;
                const targets = getTargetValues();
                Object.entries(targets).forEach(([id, val]) => {
                    const el = document.getElementById(id);
                    const formatted = val.toString().padStart(2, '0');
                    el.textContent = formatted;
                    if (formatted === '00') {
                        el.classList.add('is-zero');
                    } else {
                        el.classList.remove('is-zero');
                    }
                });
            }, 1000);
        }

        document.addEventListener('DOMContentLoaded', startSequence);
    </script>

    <style>
        .is-zero { color: #ff0000 !important; text-shadow: 0 0 15px rgba(255, 0, 0, 0.5); }
    </style>
</body>
</html>